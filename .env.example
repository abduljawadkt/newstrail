# ---- Database ----
DATABASE_URL="postgresql://newstrail:newstrail@localhost:5432/newstrail?schema=public"

# ---- NextAuth ----
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"   # openssl rand -base64 32

# Public base URL (payment callbacks, emails, sitemap)
APP_URL="http://localhost:3000"

# ---- Storage ----
# "local" = write to /public/uploads (needs a persistent disk).
# "s3"    = any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2).
STORAGE_DRIVER="local"

# Only needed when STORAGE_DRIVER=s3:
# Cloudflare R2 example:
#   S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
#   S3_REGION="auto"
#   S3_BUCKET="newstrail"
#   S3_ACCESS_KEY_ID="<r2 access key id>"
#   S3_SECRET_ACCESS_KEY="<r2 secret>"
#   S3_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"   # bucket public URL or your CDN domain
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ---- AI article auto-detection (optional) ----
# Anthropic API key — enables "Auto-detect articles" in the admin (Claude vision).
# Get one at https://console.anthropic.com/. Leave blank to disable the feature.
ANTHROPIC_API_KEY=""

# ---- Easebuzz ----
# "mock" (demo, no keys) | "test" | "prod"
EASEBUZZ_ENV="mock"
EASEBUZZ_KEY="YOUR_EASEBUZZ_KEY"
EASEBUZZ_SALT="YOUR_EASEBUZZ_SALT"
