# ---- Database ----
DATABASE_URL="postgresql://newstrail:newstrail@localhost:5432/newstrail?schema=public"

# ---- NextAuth ----
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# ---- Easebuzz (get real values from your Easebuzz dashboard) ----
# EASEBUZZ_ENV: "test" -> https://testpay.easebuzz.in ; "prod" -> https://pay.easebuzz.in
EASEBUZZ_ENV="test"
EASEBUZZ_KEY="YOUR_EASEBUZZ_KEY"
EASEBUZZ_SALT="YOUR_EASEBUZZ_SALT"

# Public base URL used to build Easebuzz success/failure callback URLs
APP_URL="http://localhost:3000"
